[Unit]
Description=Tor bootstrap watcher for SysLinuxOS Anonimo
BindsTo=syslinuxos-anonimo-tor.service
After=syslinuxos-anonimo-tor.service

[Service]
Type=simple
User=_anonimo
Group=_anonimo
ExecStart=/usr/lib/syslinuxos-anonimo/anonimo-watch
Restart=on-failure
RestartSec=2
RuntimeDirectory=syslinuxos-anonimo/status
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
